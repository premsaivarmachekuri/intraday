# ─── TradingView Authentication ───────────────────────────────────────────────
#
# METHOD 1 (RECOMMENDED — bypasses bot detection):
#   Log in to tradingview.com in Chrome, then:
#   DevTools (F12) → Application → Storage → Cookies → https://www.tradingview.com
#   Copy the values of: sessionid  and  sessionid_sign
#
TV_SESSION=your_sessionid_cookie_value
TV_SIGNATURE=your_sessionid_sign_cookie_value
#
# METHOD 2 (fallback — often blocked by TradingView bot detection):
TV_USERNAME=your_tradingview_username_or_email
TV_PASSWORD=your_tradingview_password

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get bot token from @BotFather, chat ID from @userinfobot (or send /start to your bot)
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=data/market.db
